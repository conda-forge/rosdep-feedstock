+def _is_pixi_manifest(path):
+    if os.path.basename(path) == 'pixi.toml':
+        return os.path.isfile(path)
+    try:
+        with open(path) as f:
+            return any(line.strip().startswith('[tool.pixi') for line in f)
+    except (IOError, OSError):
+        return False
+
+
+def get_pixi_manifest():
+    """
+    Return the manifest of the pixi workspace rosdep runs in, or None.
+
+    Inside `pixi run`/`pixi shell` pixi exports PIXI_PROJECT_MANIFEST.
+    Otherwise, search for a manifest from the current directory upwards like
+    pixi does, unless a different conda environment is activated.
+    """
+    manifest = os.environ.get('PIXI_PROJECT_MANIFEST')
+    if manifest and os.path.isfile(manifest):
+        return manifest
+    path = os.getcwd()
+    while True:
+        for name in ('pixi.toml', 'pyproject.toml'):
+            manifest = os.path.join(path, name)
+            if _is_pixi_manifest(manifest):
+                conda_prefix = os.environ.get('CONDA_PREFIX')
+                if conda_prefix and not os.path.realpath(conda_prefix).startswith(
+                        os.path.join(os.path.realpath(path), '')):
+                    return None
+                return manifest
+        parent = os.path.dirname(path)
+        if parent == path:
+            return None
+        path = parent
+
+
+def get_conda_mamba_cmd():
+    candidate_list = ['micromamba', 'mamba', 'conda'] if sys.platform != 'win32' else ['micromamba.exe', 'mamba.exe', 'mamba.bat', 'conda.exe', 'conda.bat']
+    if get_pixi_manifest():
+        # only use pixi inside a pixi workspace, otherwise fall back to conda/mamba
+        candidate_list.insert(0, 'pixi' if sys.platform != 'win32' else 'pixi.exe')
+    for candidate in candidate_list:
+        try:
+            subprocess.Popen([candidate], stdout=subprocess.PIPE, stderr=subprocess.PIPE).communicate()
+            return candidate
+        except OSError:
+            continue
+    raise Exception('None of ' + ', '.join(candidate_list) + ' was found.')
+
+
+def get_conda_mamba_base_cmd(subcommand):
+    cmd = get_conda_mamba_cmd()
+    if cmd not in ('pixi', 'pixi.exe'):
+        return [cmd, subcommand]
+    # pixi uses 'add' instead of 'install' and needs to know the workspace and environment
+    base_cmd = [cmd, 'add' if subcommand == 'install' else subcommand, '--manifest-path', get_pixi_manifest()]
+    if subcommand == 'list' and os.environ.get('PIXI_ENVIRONMENT_NAME'):
+        base_cmd += ['--environment', os.environ['PIXI_ENVIRONMENT_NAME']]
+    return base_cmd
+
+
